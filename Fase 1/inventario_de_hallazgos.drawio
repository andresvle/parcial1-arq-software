        <mxCell id="c11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#e0e0e0;fillColor=#1c1d27;strokeColor=#33354a;spacing=8;" value="El sistema pierde flexibilidad para adaptarse a nuevos productos o formatos de carga, lo que puede generar errores en la información y aumentar el esfuerzo de mantenimiento." vertex="1">
