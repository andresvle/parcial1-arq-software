        <mxCell id="c8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#e0e0e0;fillColor=#1c1d27;strokeColor=#33354a;spacing=8;" value="BibFarmacia/Servicios/ServicioProducto.cs&amp;nbsp;" vertex="1">
