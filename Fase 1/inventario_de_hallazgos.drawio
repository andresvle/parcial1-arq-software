        <mxCell id="c9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#e0e0e0;fillColor=#1c1d27;strokeColor=#33354a;spacing=8;" value="La carga de productos depende de un formato fijo y crea algunos datos con valores predeterminados, lo que dificulta manejar otros tipos de productos o cambios en la información de entrada. ln75" vertex="1">
          <mxGeometry height="220" width="340" x="410" y="100" as="geometry" />
