        </mxCell>
        <mxCell id="TDZT6wjji89uUiKdac-D-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#e0e0e0;fillColor=#20222f;strokeColor=#33354a;spacing=8;" value="Servicio producto se encarga de:&lt;br&gt;1. Agregar productos ln27&lt;div&gt;2. Consultar productos ln42&lt;/div&gt;&lt;div&gt;3. Verificar stock ln47&lt;/div&gt;&lt;div&gt;4.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;Verificar vencimiento ln59&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;5. Leer archivos&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;ln75&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;6. Disparar eventos ejemplo ln 69&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="410" y="820" as="geometry" />
        </mxCell>
        <mxCell id="TDZT6wjji89uUiKdac-D-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#e0e0e0;fillColor=#20222f;strokeColor=#33354a;spacing=8;" value="Se compromete single responsibility a más no poder. Eso sin mencionar que también se está violando OCP que ya lo mencionamos en H-01. Hace que el código sea dificil de mantener, probar y modificar." vertex="1">
          <mxGeometry height="160" width="210" x="750" y="820" as="geometry" />
        </mxCell>
